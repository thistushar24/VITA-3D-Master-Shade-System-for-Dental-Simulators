{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd versions/v1 && npm ci && npm run build",
  "outputDirectory": "versions/v1/dist",
  "build": {
    "env": {
      "VITE_API_MODE": "stateless"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/app.py"
    },
    {
      "source": "/api",
      "destination": "/api/app.py"
    },
    {
      "source": "/docs",
      "destination": "/api/app.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/app.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/app.py": {
      "maxDuration": 30,
      "excludeFiles": "{frontend/**,versions/**,docs/**,processed_part1_upper/**,processed_part1_lower/**,private_data/**,backend/tests/**,backend/storage/**,**/node_modules/**,.venv/**,.git/**}"
    }
  }
}
