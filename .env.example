# Copy to .env for local use (never commit .env). All variables are optional.
PORT=8000                                   # Render sets this automatically
DENTAL_LIBRARY_DIR=data/demo_library       # catalogue.json + *.npz model library (procedural demo; point to a private real library locally)
DENTAL_MODEL_ROOTS=data/samples             # os.pathsep-separated roots of per-tooth OBJ case folders
DENTAL_STORAGE=backend/storage              # uploads/sessions/exports (ephemeral on Render free tier)
DENTAL_MAX_IMAGE_MB=20
DENTAL_MAX_MESH_MB=100
DENTAL_CORS=http://localhost:5173,http://localhost:5174   # only needed when the UI is served from another origin
# Frontend build-time (versions/v1): only if the API is on a different origin than the UI
# VITE_API_BASE=https://your-api.example.com
